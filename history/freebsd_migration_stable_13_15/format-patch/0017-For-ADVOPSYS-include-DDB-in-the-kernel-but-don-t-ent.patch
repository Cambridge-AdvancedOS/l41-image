From 59c6d088ca78fc61f7e37ac3402d4bbcac447cfe Mon Sep 17 00:00:00 2001
From: "Robert N. M. Watson" <robert.watson@cl.cam.ac.uk>
Date: Thu, 30 Dec 2021 20:47:21 +0000
Subject: [PATCH 17/19] For ADVOPSYS, include DDB in the kernel, but don't
 enter DDB on panic.

---
 sys/arm64/conf/ADVOPSYS | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/sys/arm64/conf/ADVOPSYS b/sys/arm64/conf/ADVOPSYS
index 6b555dad3392..89e9192d9b4b 100644
--- a/sys/arm64/conf/ADVOPSYS
+++ b/sys/arm64/conf/ADVOPSYS
@@ -13,3 +13,6 @@ ident		ADVOPSYS
 options 	DUMMYNET
 options 	IPFIREWALL
 options 	IPFIREWALL_DEFAULT_TO_ACCEPT
+
+options 	KDB_UNATTENDED
+options 	DDB
