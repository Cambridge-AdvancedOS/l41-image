From cc07c14fa75679401c758ae16dd4324a849d56a9 Mon Sep 17 00:00:00 2001
From: "Robert N. M. Watson" <robert.watson@cl.cam.ac.uk>
Date: Mon, 22 Feb 2021 17:57:12 +0000
Subject: [PATCH 03/19] Define symbols for the start and end of each
 assembly-language kernel function in aarch64, so that we can more easily
 check if the PC is within those ranges.

---
 sys/arm64/include/asm.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/sys/arm64/include/asm.h b/sys/arm64/include/asm.h
index 05e618500e59..63165ca35689 100644
--- a/sys/arm64/include/asm.h
+++ b/sys/arm64/include/asm.h
@@ -39,13 +39,13 @@
 #define	_C_LABEL(x)	x
 
 #define	LENTRY(sym)						\
-	.text; .align 2; .type sym,#function; sym:		\
+	.text; .align 2; .type sym,#function; sym: __ ## sym ## _start: \
 	.cfi_startproc
 #define	ENTRY(sym)						\
 	.globl sym; LENTRY(sym)
 #define	EENTRY(sym)						\
 	.globl	sym; sym:
-#define	LEND(sym) .ltorg; .cfi_endproc; .size sym, . - sym
+#define	LEND(sym) .ltorg; .cfi_endproc; .size sym, . - sym; __ ## sym ## _end:
 #define	END(sym) LEND(sym)
 #define	EEND(sym)
 
-- 
2.55.0

