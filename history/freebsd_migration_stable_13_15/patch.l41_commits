commit 667601043f177c7457bb9971404f4b49a8d55ab8
Author: Robert N. M. Watson <robert.watson@cl.cam.ac.uk>
Date:   Mon Feb 22 17:57:36 2021 +0000

    Add stack frames for aarch64 memory-zeroing functions.
    
    With this change they are more visible in stack traces.

diff --git a/sys/arm64/arm64/bzero.S b/sys/arm64/arm64/bzero.S
index 6c7f1fef1494..1a95a7b99140 100644
--- a/sys/arm64/arm64/bzero.S
+++ b/sys/arm64/arm64/bzero.S
@@ -39,6 +39,8 @@ __FBSDID("$FreeBSD$");
 	 *  x1 - size
 	 */
 ENTRY(bzero)
+	stp	x29, x30, [sp, #-16]!
+	mov	x29, sp
 	cbz	x1, ending
 
 	/*
@@ -200,6 +202,7 @@ cache_line_zero:
 	b.ne	normal
 
 ending:
+	ldp	x29, x30, [sp], #16
 	ret
 
 END(bzero)
diff --git a/sys/arm64/arm64/support.S b/sys/arm64/arm64/support.S
index 4771814a9b45..c9efa592943b 100644
--- a/sys/arm64/arm64/support.S
+++ b/sys/arm64/arm64/support.S
@@ -227,6 +227,8 @@ END(longjmp)
  * pagezero, simple implementation
  */
 ENTRY(pagezero_simple)
+	stp	x29, x30, [sp, #-16]!
+	mov	x29, sp
 	add	x1, x0, #PAGE_SIZE
 
 1:
@@ -236,6 +238,7 @@ ENTRY(pagezero_simple)
 	stp	xzr, xzr, [x0], #0x10
 	cmp	x0, x1
 	b.ne	1b
+	ldp	x29, x30, [sp], #16
 	ret
 
 END(pagezero_simple)
@@ -244,6 +247,8 @@ END(pagezero_simple)
  * pagezero, cache assisted
  */
 ENTRY(pagezero_cache)
+	stp	x29, x30, [sp, #-16]!
+	mov	x29, sp
 	add	x1, x0, #PAGE_SIZE
 
 	ldr	x2, =dczva_line_size
@@ -254,6 +259,7 @@ ENTRY(pagezero_cache)
 	add	x0, x0, x2
 	cmp	x0, x1
 	b.ne	1b
+	ldp	x29, x30, [sp], #16
 	ret
 
 END(pagezero_cache)

commit cc07c14fa75679401c758ae16dd4324a849d56a9
Author: Robert N. M. Watson <robert.watson@cl.cam.ac.uk>
Date:   Mon Feb 22 17:57:12 2021 +0000

    Define symbols for the start and end of each assembly-language kernel
    function in aarch64, so that we can more easily check if the PC is
    within those ranges.

diff --git a/sys/arm64/include/asm.h b/sys/arm64/include/asm.h
index 05e618500e59..63165ca35689 100644
--- a/sys/arm64/include/asm.h
+++ b/sys/arm64/include/asm.h
@@ -39,13 +39,13 @@
 #define	_C_LABEL(x)	x
 
 #define	LENTRY(sym)						\
-	.text; .align 2; .type sym,#function; sym:		\
+	.text; .align 2; .type sym,#function; sym: __ ## sym ## _start: \
 	.cfi_startproc
 #define	ENTRY(sym)						\
 	.globl sym; LENTRY(sym)
 #define	EENTRY(sym)						\
 	.globl	sym; sym:
-#define	LEND(sym) .ltorg; .cfi_endproc; .size sym, . - sym
+#define	LEND(sym) .ltorg; .cfi_endproc; .size sym, . - sym; __ ## sym ## _end:
 #define	END(sym) LEND(sym)
 #define	EEND(sym)
 

commit 6d50512513ac85acc0941caaec17f22686960e92
Author: Robert N. M. Watson <robert.watson@cl.cam.ac.uk>
Date:   Mon Feb 22 17:57:00 2021 +0000

    The trap PC should be ELR and not LR on aarch64.

diff --git a/sys/arm64/include/cpu.h b/sys/arm64/include/cpu.h
index 529f156f2e96..ab1a1666cbe1 100644
--- a/sys/arm64/include/cpu.h
+++ b/sys/arm64/include/cpu.h
@@ -45,7 +45,7 @@
 #include <machine/frame.h>
 #include <machine/armreg.h>
 
-#define	TRAPF_PC(tfp)		((tfp)->tf_lr)
+#define	TRAPF_PC(tfp)		((tfp)->tf_elr)
 #define	TRAPF_USERMODE(tfp)	(((tfp)->tf_spsr & PSR_M_MASK) == PSR_M_EL0t)
 
 #define	cpu_getstack(td)	((td)->td_frame->tf_sp)

commit 07f6b99e20096c463b23e52231b50a18f6fe3ee4
Author: Robert Watson <rwatson@FreeBSD.org>
Date:   Tue Feb 16 15:19:05 2021 +0000

    Reimplement the arm64 dtrace_gethrtime(), which provides the
    high-resolution nanosecond timestamp used for the DTrace 'timestamp'
    built-in variable.  The new implementation uses the EL0 cycle
    counter and frequency registers in ARMv8-A.  This replaces a
    previous implementation that relied on an instrumentation-safe
    implementation of getnanotime(), which provided only timer
    resolution.
    
    MFC after:      3 days
    Reviewed by:    andrew, bsdimp (older version)
    Useful comments appreciated:    jrtc27, emaste

diff --git a/sys/cddl/dev/dtrace/aarch64/dtrace_subr.c b/sys/cddl/dev/dtrace/aarch64/dtrace_subr.c
index 6646e51fc191..9bf9f0798bb5 100644
--- a/sys/cddl/dev/dtrace/aarch64/dtrace_subr.c
+++ b/sys/cddl/dev/dtrace/aarch64/dtrace_subr.c
@@ -153,23 +153,26 @@ dtrace_sync(void)
 }
 
 /*
